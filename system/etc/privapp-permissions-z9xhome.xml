<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen OS: /system/etc/permissions/privapp-permissions-z9xhome.xml (0644, root:root, system_file).
     org.z9x.home lives in /system/priv-app/Z9xHome (platform-signed). ro.control_privapp_permissions=disable
     today, so this list is not enforced; it is shipped so that "enforce" in a future base does not break
     boot. ACCESS_ALL_EPG_DATA is signature|privileged against TvProvider's own certificate, so only the
     "privileged" path can grant it to us. -->
<permissions>
    <privapp-permissions package="org.z9x.home">
        <permission name="com.android.providers.tv.permission.ACCESS_ALL_EPG_DATA" />
        <permission name="android.permission.GLOBAL_SEARCH" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <permission name="android.permission.HDMI_CEC" />
        <permission name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <!-- 1.0.1: Apps > Install from USB (a trusted installer; every install still asks the user) -->
        <permission name="android.permission.INSTALL_PACKAGES" />
    </privapp-permissions>
</permissions>
