#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Test stub of Android's setprop: updates $Z9X_T/props and appends to $Z9X_T/setprop.log. Like the real
# property service it refuses a value longer than 91 bytes (PROP_VALUE_MAX - 1) and a second write of a
# ro.* property (logged as TOO_LONG / RO_TWICE: every case fails on either).
k=$1; v=${2-}
if [ ${#v} -gt 91 ]; then echo "setprop: value too long: $k" >&2; echo "TOO_LONG $k" >> "$Z9X_T/setprop.log"; exit 1; fi
case "$k" in
  ro.*) if awk -v k="$k" 'index($0, k "=") == 1 { f = 1 } END { exit !f }' "$Z9X_T/props" 2>/dev/null; then
          echo "setprop: read-only $k" >&2; echo "RO_TWICE $k" >> "$Z9X_T/setprop.log"; exit 1
        fi ;;
esac
awk -v k="$k" 'index($0, k "=") != 1' "$Z9X_T/props" > "$Z9X_T/props.tmp" 2>/dev/null
printf '%s=%s\n' "$k" "$v" >> "$Z9X_T/props.tmp"
mv "$Z9X_T/props.tmp" "$Z9X_T/props"
printf '%s=%s\n' "$k" "$v" >> "$Z9X_T/setprop.log"
