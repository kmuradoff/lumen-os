# Z9X (LineageOS 21 TV) keylayout for Vendor_0001_Product_0001:
#   XGIMI-shipped TV-style remote layout (0001:0001)
# Generated by make_keylayouts.py from the stock /vendor/usr/keylayout/Vendor_0001_Product_0001.kl.
# XGIMI-only labels are remapped ("XGIMI:" comments) or dropped; see global_keys.xml for the
# keys routed to org.z9x.projector / org.z9x.tvinput.
# v6.5: IR / keypad power keys are STB_POWER WAKE too (own power key -> org.z9x.projector: short = lamp-only
# standby, long = power menu; from a real Android sleep the key still wakes). Only the factory remotes keep
# POWER WAKE as the system fallback.

key 116        STB_POWER WAKE
key 2          1
key 3          2
key 4          3
key 5          4
key 6          5
key 7          6
key 8          7
key 9          8
key 10         9
key 11         0
key 56         ALT_LEFT
key 100        ALT_RIGHT
key 42         SHIFT_LEFT
key 54         SHIFT_RIGHT
key 57         SPACE
key 58         SOFT_RIGHT
key 465        LAST_CHANNEL
key 402        CHANNEL_UP
key 403        CHANNEL_DOWN
key 115        VOLUME_UP
key 114        VOLUME_DOWN
key 113        VOLUME_MUTE
key 28         DPAD_CENTER
key 103        DPAD_UP
key 108        DPAD_DOWN
key 105        DPAD_LEFT
key 106        DPAD_RIGHT
key 158        CLEAR
key 139        MENU
key 102        HOME
key 398        PROG_RED
key 399        PROG_GREEN
key 400        PROG_YELLOW
key 401        PROG_BLUE
key 165        MEDIA_PREVIOUS
key 163        MEDIA_NEXT
key 168        MEDIA_REWIND
key 208        MEDIA_FAST_FORWARD
key 164        MEDIA_PLAY_PAUSE
key 166        MEDIA_STOP
key 167        MEDIA_RECORD
key 155        ENVELOPE
key 12         MINUS
key 13         EQUALS
key 215        AT
key 130        ZOOM_IN
key 131        ZOOM_OUT
key 15         BACK
key 466        TV_INPUT
key 111        PAGE_UP
key 112        PAGE_DOWN
key 358        INFO
key 213        CAPTIONS
