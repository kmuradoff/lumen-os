# Z9X (LineageOS 21 TV) keylayout for Vendor_1d5a_Product_c081:
#   XGIMI BLE voice remote (c081)
# Generated by make_keylayouts.py from the stock /vendor/usr/keylayout/Vendor_1d5a_Product_c081.kl.
# XGIMI-only labels are remapped ("XGIMI:" comments) or dropped; see global_keys.xml for the
# keys routed to org.z9x.projector / org.z9x.tvinput.

key 28         DPAD_CENTER
key 103        DPAD_UP
key 105        DPAD_LEFT
key 106        DPAD_RIGHT
key 108        DPAD_DOWN
key 116        STB_POWER WAKE  # XGIMI: KPPOWER (BT). v6.2: own power key -> org.z9x.projector (short=fade+sleep, long=power menu); wakes when off (press swallowed by the framework). v6.5: IR/keypad power keys are STB_POWER WAKE as well; only the factory remotes keep system POWER.
key 114        VOLUME_DOWN
key 115        VOLUME_UP
key 172        HOME
key 1          BACK
key 139        ALL_APPS  # XGIMI: MENU (four-diamond key) -> Google TV "Your apps"
key 63         SEARCH WAKE  # XGIMI: F5 = voice key (audio streams only while held) -> Google Assistant via org.z9x.projector
key 64         SETTINGS  # XGIMI: MOVE_HOME; gear -> org.z9x.projector quick panel (short) / TvSettings (long)
# key 65       STEM_1  (dropped: STEM_1 is a wake key by itself (KeyEvent.isWakeKey); meaning unknown)
# key 88       RC_LOW_BATTERY  (dropped: remote low-battery report, not a key)
# key 185      SECONDARY_POWER  (not mapped yet: stock XgimiWindowManager handles it (2130) exactly
#   like KPPOWER (2100): wake from sleep, swallow the waking press. Not mapped blindly: if one press
#   sends both the main power scancode and 185, Android has no stock-like dedupe and one press would
#   wake and then sleep. First boot: check the power button with `getevent -lt`; map
#   "key 185 POWER WAKE" only if it sends 185 alone.)
key 358        VOLUME_MUTE
key 137        SEARCH WAKE  # XGIMI: SHORTCUT_AI; AI key -> Google Assistant via org.z9x.projector
