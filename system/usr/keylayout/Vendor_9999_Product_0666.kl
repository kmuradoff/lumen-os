# Z9X (LineageOS 21 TV) keylayout for Vendor_9999_Product_0666:
#   XGIMI factory remote
# Generated by make_keylayouts.py from the stock /vendor/usr/keylayout/Vendor_9999_Product_0666.kl.
# XGIMI-only labels are remapped ("XGIMI:" comments) or dropped; see global_keys.xml for the
# keys routed to org.z9x.projector / org.z9x.tvinput.

key 1          BACK
key 2          HOME
key 3          MENU
key 4          POWER WAKE
key 5          DPAD_UP
key 6          POWER WAKE  # XGIMI: KPPOWER; system POWER (fallback): v6.5 short = nothing while awake (config_shortPressOnPowerBehavior 0, Z9xFrameworkKeysOverlay), wakes from a sleep; long = system power menu (power off, restart)
key 7          DPAD_LEFT
key 8          DPAD_DOWN
key 9          SETTINGS  # XGIMI: MOVE_HOME; gear -> org.z9x.projector quick panel (short) / TvSettings (long)
key 10         VOLUME_UP
key 11         DPAD_RIGHT
key 12         MEDIA_STEP_BACKWARD  # XGIMI: FOCUS_LEFT; manual focus step (hold) -> org.z9x.projector
key 13         FOCUS  # XGIMI: FOCUS_AUTO; focus key short press -> org.z9x.projector autofocus
key 14         DPAD_CENTER
key 15         MEDIA_STEP_FORWARD  # XGIMI: FOCUS_RIGHT; manual focus step (hold) -> org.z9x.projector
key 16         VOLUME_DOWN
# key 17       RESTART  (dropped: factory remote restart, never map)
