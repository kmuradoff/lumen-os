# Z9X (LineageOS 21 TV) keylayout for Vendor_000d_Product_3843:
#   XGIMI BLE remote (picture-mode keys)
# Generated by make_keylayouts.py from the stock /vendor/usr/keylayout/Vendor_000d_Product_3843.kl.
# XGIMI-only labels are remapped ("XGIMI:" comments) or dropped; see global_keys.xml for the
# keys routed to org.z9x.projector / org.z9x.tvinput.

key 28         DPAD_CENTER
key 103        DPAD_UP
key 105        DPAD_LEFT
key 106        DPAD_RIGHT
key 108        DPAD_DOWN
key 113        STB_POWER WAKE  # XGIMI: KPPOWER (BT). v6.2: own power key -> org.z9x.projector (short=fade+sleep, long=power menu); wakes when off (press swallowed by the framework). v6.5: IR/keypad power keys are STB_POWER WAKE as well; only the factory remotes keep system POWER.
key 114        VOLUME_DOWN
key 115        VOLUME_UP
key 102        HOME
key 1          BACK
key 127        ALL_APPS  # XGIMI: MENU (four-diamond key) -> Google TV "Your apps"
key 66         SETTINGS  # XGIMI: MOVE_HOME; gear -> org.z9x.projector quick panel (short) / TvSettings (long)
key 358        VOLUME_MUTE
# key 206      STANDARD_HW  (dropped: XGIMI-only label, no AOSP keycode)
# key 174      MOVIE  (dropped: XGIMI-only label, no AOSP keycode)
# key 234      VIVID  (dropped: XGIMI-only label, no AOSP keycode)
# key 210      TV_HW  (dropped: XGIMI-only label, no AOSP keycode)
# key 130      PATTERN  (dropped: XGIMI-only label, no AOSP keycode)
key 133        FOCUS  # XGIMI: FOCUS_AUTO_NEW; focus key short press -> org.z9x.projector autofocus
key 430        TV_INPUT  # XGIMI: SINGAL; Source -> org.z9x.projector input overlay
