# Z9X (LineageOS 21 TV) keylayout for Vendor_000d_Product_3838:
#   XGIMI BLE remote (older revision; note: same VID/PID as Google ADT-3 remote, XGIMI scancodes kept)
# Generated by make_keylayouts.py from the stock /vendor/usr/keylayout/Vendor_000d_Product_3838.kl.
# XGIMI-only labels are remapped ("XGIMI:" comments) or dropped; see global_keys.xml for the
# keys routed to org.z9x.projector / org.z9x.tvinput.

key 28         DPAD_CENTER
key 67         MEDIA_STEP_BACKWARD  # XGIMI: RC_FOCUS_LEFT; manual focus step (hold) -> org.z9x.projector
key 68         MEDIA_STEP_FORWARD  # XGIMI: RC_FOCUS_RIGHT; manual focus step (hold) -> org.z9x.projector
key 103        DPAD_UP
key 105        DPAD_LEFT
key 106        DPAD_RIGHT
key 108        DPAD_DOWN
key 113        STB_POWER WAKE  # XGIMI: KPPOWER (BT). v6.2: own power key -> org.z9x.projector (short=fade+sleep, long=power menu); wakes when off (press swallowed by the framework). v6.5: IR/keypad power keys are STB_POWER WAKE as well; only the factory remotes keep system POWER.
key 114        VOLUME_DOWN
key 115        VOLUME_UP
key 102        HOME
key 1          BACK
key 127        ALL_APPS  # XGIMI: MENU (four-diamond key) -> Google TV "Your apps"
key 66         SETTINGS  # XGIMI: MOVE_HOME; gear -> org.z9x.projector quick panel (short) / TvSettings (long)
key 87         FOCUS  # XGIMI: FOCUS_AUTO; focus key short press -> org.z9x.projector autofocus
key 63         SEARCH WAKE  # XGIMI: F5 = voice key (audio streams only while held) -> Google Assistant via org.z9x.projector
# key 64       MUSIC_SOUNDERMODE  (dropped: speaker mode, no equivalent)
key 65         FOCUS  # XGIMI: FOCUS_AUTO_NEW; focus key short press -> org.z9x.projector autofocus
key 62         TV_CONTENTS_MENU  # XGIMI: FOCUS_MAN_NEW; focus key long press -> org.z9x.projector manual-focus overlay
# key 88       RC_LOW_BATTERY  (dropped: remote low-battery report, not a key)
key 183        TV_SATELLITE_SERVICE  # XGIMI: AMBIENT; stock "screen saver" key -> org.z9x.projector starts Ambient mode
key 184        ALL_APPS  # XGIMI: SHORTCUT; stock DIY shortcut key -> all apps (hedge for the four-diamond key)
# key 185      SECONDARY_POWER  (not mapped yet: stock XgimiWindowManager handles it (2130) exactly
#   like KPPOWER (2100): wake from sleep, swallow the waking press. Not mapped blindly: if one press
#   sends both the main power scancode and 185, Android has no stock-like dedupe and one press would
#   wake and then sleep. First boot: check the power button with `getevent -lt`; map
#   "key 185 POWER WAKE" only if it sends 185 alone.)
