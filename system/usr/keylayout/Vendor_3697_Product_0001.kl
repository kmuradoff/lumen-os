# Z9X (LineageOS 21 TV) keylayout for Vendor_3697_Product_0001:
#   MTK Smart TV IR Receiver (IR fallback of every XGIMI remote; power-HAL injects 116 on resume)
# Generated by make_keylayouts.py from the stock /vendor/usr/keylayout/Vendor_3697_Product_0001.kl.
# XGIMI-only labels are remapped ("XGIMI:" comments) or dropped; see global_keys.xml for the
# keys routed to org.z9x.projector / org.z9x.tvinput.
# v6.5: IR / keypad power keys are STB_POWER WAKE too (own power key -> org.z9x.projector: short = lamp-only
# standby, long = power menu; from a real Android sleep the key still wakes). Only the factory remotes keep
# POWER WAKE as the system fallback.

key 2          1
key 3          2
key 4          3
key 5          4
key 6          5
key 7          6
key 8          7
key 9          8
key 10         9
key 11         0
key 103        DPAD_UP
key 108        DPAD_DOWN
key 105        DPAD_LEFT
key 106        DPAD_RIGHT
key 115        VOLUME_UP
key 114        VOLUME_DOWN
key 116        STB_POWER WAKE
key 102        HOME
key 139        ALL_APPS  # XGIMI: MENU (four-diamond key) -> Google TV "Your apps"
key 158        BACK
key 113        VOLUME_MUTE
key 190        STB_POWER WAKE  # XGIMI: KPPOWER; v6.5 own power key -> org.z9x.projector (short = standby, long = power menu)
key 191        DPAD_CENTER
key 192        SETTINGS  # XGIMI: MOVE_HOME; gear -> org.z9x.projector quick panel (short) / TvSettings (long)
key 193        MEDIA_STEP_BACKWARD  # XGIMI: FOCUS_LEFT; manual focus step (hold) -> org.z9x.projector
key 194        MEDIA_STEP_FORWARD  # XGIMI: FOCUS_RIGHT; manual focus step (hold) -> org.z9x.projector
# key 189      CAST  (dropped: XGIMI-only label, no AOSP keycode)
# key 188      STANDARD  (dropped: XGIMI-only label, no AOSP keycode)
# key 187      CINEMA  (dropped: XGIMI-only label, no AOSP keycode)
# key 186      BRIGHT  (dropped: XGIMI-only label, no AOSP keycode)
# key 185      USER  (dropped: XGIMI-only label, no AOSP keycode)
# key 184      PATTERN  (dropped: XGIMI-only label, no AOSP keycode)
key 183        TV_NETWORK  # XGIMI: LENS; projector picture/keystone panel -> org.z9x.projector
key 88         TV_INPUT  # XGIMI: SINGAL; Source -> org.z9x.projector input overlay
key 240        INFO
# key 60       OSD_OFF  (dropped: XGIMI-only label, no AOSP keycode)
key 61         MEDIA_STEP_FORWARD  # XGIMI: FOCUS_RIGHT; manual focus step (hold) -> org.z9x.projector
key 62         MEDIA_STEP_BACKWARD  # XGIMI: FOCUS_LEFT; manual focus step (hold) -> org.z9x.projector
# key 63       ROTATE  (dropped: XGIMI-only label, no AOSP keycode)
key 64         TV_NETWORK  # XGIMI: KEYSTONE; projector picture/keystone panel -> org.z9x.projector
# key 65       ZOOM_SHIFT  (dropped: XGIMI-only label, no AOSP keycode)
# key 66       SPLIT_SCREEN  (dropped: XGIMI-only label, no AOSP keycode)
# key 67       TODEFAULT  (dropped: stock factory-reset shortcut, never map)
key 68         TV_INPUT_HDMI_1  # XGIMI: HDMI1; HDMI 1 -> org.z9x.tvinput
key 82         TV_INPUT_HDMI_2  # XGIMI: HDMI2; HDMI 2 -> org.z9x.tvinput
key 75         STB_POWER WAKE  # XGIMI: DORMANCY; dedicated IR sleep key. v6.5: STB_POWER like the power key (org.z9x.projector: short = lamp-only standby / wake from it, long = power menu); KEYCODE_SLEEP would be PhoneWindowManager goToSleep (display power cycle)
# key 79       SOURCE_USB  (dropped: XGIMI-only label, no AOSP keycode)
# key 80       HDBASET  (dropped: XGIMI-only label, no AOSP keycode)
# key 81       IR_LOW_BATTERY  (dropped: remote low-battery report, not a key)
# key 87       OSD_ON  (dropped: XGIMI-only label, no AOSP keycode)
