# Z9X (LineageOS 21 TV) keylayout for Vendor_26e3_Product_af02:
#   XGIMI BLE remote without voice
# Generated by make_keylayouts.py from the stock /vendor/usr/keylayout/Vendor_26e3_Product_af02.kl.
# XGIMI-only labels are remapped ("XGIMI:" comments) or dropped; see global_keys.xml for the
# keys routed to org.z9x.projector / org.z9x.tvinput.

key 116        STB_POWER WAKE  # XGIMI: KPPOWER (BT). v6.2: own power key -> org.z9x.projector (short=fade+sleep, long=power menu); wakes when off (press swallowed by the framework). v6.5: IR/keypad power keys are STB_POWER WAKE as well; only the factory remotes keep system POWER.
key 28         DPAD_CENTER
key 67         MEDIA_STEP_BACKWARD  # XGIMI: FOCUS_LEFT; manual focus step (hold) -> org.z9x.projector
key 68         MEDIA_STEP_FORWARD  # XGIMI: FOCUS_RIGHT; manual focus step (hold) -> org.z9x.projector
key 103        DPAD_UP
key 105        DPAD_LEFT
key 106        DPAD_RIGHT
key 108        DPAD_DOWN
key 113        VOLUME_MUTE
key 114        VOLUME_DOWN
key 115        VOLUME_UP
key 102        HOME
key 1          BACK
key 127        ALL_APPS  # XGIMI: MENU (four-diamond key) -> Google TV "Your apps"
key 66         SETTINGS  # XGIMI: MOVE_HOME; gear -> org.z9x.projector quick panel (short) / TvSettings (long)
