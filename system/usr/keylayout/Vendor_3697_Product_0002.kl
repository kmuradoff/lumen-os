# Z9X (LineageOS 21 TV) keylayout for Vendor_3697_Product_0002:
#   MTK TV KEYPAD (projector body) and ucontrol_key (XGIMI phone-app LAN remote)
# Generated by make_keylayouts.py from the stock /vendor/usr/keylayout/Vendor_3697_Product_0002.kl.
# XGIMI-only labels are remapped ("XGIMI:" comments) or dropped; see global_keys.xml for the
# keys routed to org.z9x.projector / org.z9x.tvinput.
# v6.5: IR / keypad power keys are STB_POWER WAKE too (own power key -> org.z9x.projector: short = lamp-only
# standby, long = power menu; from a real Android sleep the key still wakes). Only the factory remotes keep
# POWER WAKE as the system fallback.

key 30         STB_POWER WAKE
key 48         BACK
key 35         HOME
key 36         DPAD_UP
key 37         DPAD_RIGHT
key 38         DPAD_DOWN
key 50         DPAD_LEFT
key 49         DPAD_CENTER
key 88         F12
key 116        STB_POWER WAKE
key 113        VOLUME_MUTE
key 115        VOLUME_UP
key 114        VOLUME_DOWN
key 139        ALL_APPS  # XGIMI: MENU (four-diamond key) -> Google TV "Your apps"
key 251        SETTINGS  # XGIMI: MOVE_HOME; gear -> org.z9x.projector quick panel (short) / TvSettings (long)
key 254        MEDIA_STEP_FORWARD  # XGIMI: FOCUS_RIGHT; manual focus step (hold) -> org.z9x.projector
key 253        MEDIA_STEP_BACKWARD  # XGIMI: FOCUS_LEFT; manual focus step (hold) -> org.z9x.projector
key 165        MEDIA_PREVIOUS
key 163        MEDIA_NEXT
key 207        MEDIA_PLAY
key 119        MEDIA_PAUSE
key 138        GUIDE
