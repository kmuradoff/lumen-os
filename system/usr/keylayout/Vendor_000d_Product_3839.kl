# key 60       XGIMI_MUSICCT_SLSHOW  (dropped: XGIMI-only label, no AOSP keycode)
# key 64       XGIMI_MUSICCT_REFRESH  (dropped: XGIMI-only label, no AOSP keycode)
# key 70       XGIMI_LONG_PRESS  (dropped: XGIMI-only label, no AOSP keycode)
# key 99       NFC_PENG  (dropped: XGIMI-only label, no AOSP keycode)
key 114        VOLUME_DOWN
key 115        VOLUME_UP
key 103        DPAD_UP
key 105        DPAD_LEFT
key 106        DPAD_RIGHT
key 108        DPAD_DOWN
