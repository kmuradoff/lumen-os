+// Lumen OS: kernel release >= maj.min (true when it cannot be read, so nothing is skipped by mistake).
+static bool kernelAtLeast(int maj, int min) {
+    struct utsname u;
+    int a = 0, b = 0;
+    if (uname(&u) || sscanf(u.release, "%d.%d", &a, &b) != 2) return true;
+    return a > maj || (a == maj && b >= min);
+}
