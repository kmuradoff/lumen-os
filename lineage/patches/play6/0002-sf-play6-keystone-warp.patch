+renderengine::DisplaySettings Display::generateClientCompositionDisplaySettings(
+        const std::shared_ptr<renderengine::ExternalTexture>& buffer) const {
+    renderengine::DisplaySettings settings = Output::generateClientCompositionDisplaySettings(buffer);
+
+    // Lumen (XGIMI Play 6): keystone for a physical display only. Virtual displays, screen captures
+    // (not a Display) and the planner's cached layer sets are never warped.
+    if (mIsDisconnected || !PhysicalDisplayId::tryCast(mId)) {
+        return settings;
+    }
+    const KeystoneOffsets k = currentKeystoneOffsets();
+    const Rect& pd = settings.physicalDisplay;
+    if (!k.on || !pd.isValid() || pd.isEmpty()) {
+        return settings;
+    }
+    const float sx = static_cast<float>(pd.width()) / static_cast<float>(kPanelW);
+    const float sy = static_cast<float>(pd.height()) / static_cast<float>(kPanelH);
+    const auto l = static_cast<float>(pd.left), t = static_cast<float>(pd.top);
+    const auto r = static_cast<float>(pd.right), b = static_cast<float>(pd.bottom);
+    const auto o = [&k](size_t i) { return static_cast<float>(k.off[i]); };
+    settings.keystone = true;
+    settings.keystoneQuad = {l + o(0) * sx, t + o(1) * sy, r - o(2) * sx, t + o(3) * sy,
+                             r - o(4) * sx, b - o(5) * sy, l + o(6) * sx, b - o(7) * sy};
+    return settings;
 }
 
