 using aidl::android::hardware::graphics::composer3::Capability;
 using aidl::android::hardware::graphics::composer3::DisplayCapability;
 
 namespace android::compositionengine::impl {
 
+namespace {
+
+// Lumen (XGIMI Play 6): the keystone corners. The vendor trapezoidServer stores them as inward
+// offsets "x:y" from each corner of the 1920x1080 panel, then bumps the trigger counter; the vendor
+// HWC sees the counter and asks SurfaceFlinger for a refresh. The stock (Android 11) XGIMI
+// SurfaceFlinger warped the client target with them; this does the same. The props are read again
+// only when the trigger counter changes, so a frame costs one serial check. Inert anywhere the vendor
+// does not publish them (enable must be 1 and the type the four-corner type 1).
+constexpr const char* kKeystoneTrigger = "vendor.mstar.trapezoid.trigger.osd.offset";
+constexpr int kPanelW = 1920, kPanelH = 1080;
+
+struct KeystoneOffsets {
+    bool on = false;
+    std::array<int, 8> off{}; // lt x, y, rt x, y, rb x, y, lb x, y (panel px, inward)
+};
+
+bool readKeystoneOffset(const char* name, int* x, int* y) {
+    const std::string v = base::GetProperty(name, "");
+    char tail;
+    if (std::sscanf(v.c_str(), "%d:%d%c", x, y, &tail) != 2) return false;
+    return *x >= 0 && *y >= 0 && *x <= kPanelW / 2 && *y <= kPanelH / 2;
+}
+
+KeystoneOffsets readKeystoneOffsets() {
+    KeystoneOffsets k;
+    if (base::GetIntProperty("vendor.mstar.trapezoid.enable", 0) != 1 ||
+        base::GetIntProperty("vendor.mstar.trapezoidCorrect.type", 0) != 1) {
+        return k;
+    }
+    static const char* const kNames[4] = {"vendor.mstar.pos_lt_offset", "vendor.mstar.pos_rt_offset",
+                                          "vendor.mstar.pos_rb_offset", "vendor.mstar.pos_lb_offset"};
+    for (size_t i = 0; i < 4; i++) {
+        if (!readKeystoneOffset(kNames[i], &k.off[2 * i], &k.off[2 * i + 1])) return KeystoneOffsets{};
+    }
+    for (int v : k.off) {
+        if (v != 0) k.on = true;
+    }
+    return k;
+}
+
+KeystoneOffsets currentKeystoneOffsets() {
+    static std::mutex sLock;
+    static base::CachedProperty sTrigger(kKeystoneTrigger); // serial check, no copy when unchanged
+    static bool sRead = false, sLogged = false;
+    static KeystoneOffsets sLast;
+    std::lock_guard<std::mutex> lock(sLock);
+    bool changed = false;
+    sTrigger.Get(&changed);
+    if (sRead && !changed) return sLast;
+    sRead = true;
+    const KeystoneOffsets k = readKeystoneOffsets();
+    if (!sLogged || k.on != sLast.on || k.off != sLast.off) {
+        const auto& o = k.off;
+        ALOGI("Lumen keystone %s: lt %d:%d rt %d:%d rb %d:%d lb %d:%d", k.on ? "on" : "off", o[0],
+              o[1], o[2], o[3], o[4], o[5], o[6], o[7]);
+        sLogged = true;
+    }
+    sLast = k;
+    return k;
+}
+
