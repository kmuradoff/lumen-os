+/*
+ * Lumen OS (Play 6): down-sampling, 16 bit stereo (48 kHz feeding to 44.1 kHz SBC), linear interpolation. The
+ * up-sampler below emits at least one output per input sample, so it cannot lower the rate. The state lives here,
+ * not in a2dp_sbc_ups_cb: a2dp_sbc_read_feeding initialises the up-sampler before every read.
+ */
+static int lumen_down_sample_16s(const int16_t* src, int16_t* dst, uint32_t src_samples,
+                                 uint32_t dst_samples, uint32_t src_sps, uint32_t dst_sps,
+                                 uint32_t* p_ret) {
+  static int16_t prev_l = 0, prev_r = 0;
+  static double pos = 1.0;  // next output, in input samples: 0 = prev, k = src[k - 1]
+  static uint32_t last_src = 0, last_dst = 0;
+  if (last_src != src_sps || last_dst != dst_sps) {
+    last_src = src_sps;
+    last_dst = dst_sps;
+    prev_l = prev_r = 0;
+    pos = 1.0;
+  }
+  const double step = (double)src_sps / (double)dst_sps;
+  uint32_t out = 0;
+  while (out < dst_samples) {
+    uint32_t i = (uint32_t)pos;
+    if (i >= src_samples) break;
+    double f = pos - i;
+    int32_t al = i == 0 ? prev_l : src[2 * (i - 1)];
+    int32_t ar = i == 0 ? prev_r : src[2 * (i - 1) + 1];
+    int32_t bl = src[2 * i], br = src[2 * i + 1];
+    dst[2 * out] = (int16_t)(al + (int32_t)((bl - al) * f));
+    dst[2 * out + 1] = (int16_t)(ar + (int32_t)((br - ar) * f));
+    out++;
+    pos += step;
+  }
+  if (src_samples > 0) {
+    prev_l = src[2 * (src_samples - 1)];
+    prev_r = src[2 * (src_samples - 1) + 1];
+    pos -= src_samples;
+    if (pos < 0) pos = 0;
+  }
+  *p_ret = src_samples * 4;
+  return out * 4;
+}
