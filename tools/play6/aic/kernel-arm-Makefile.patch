--- /b/arm_Makefile.orig	2026-10-27 19:07:21.574028142 +0000
+++ /b/linux-4.19.116/arch/arm/Makefile	2026-10-27 19:07:21.730027713 +0000
@@ -115,6 +115,10 @@
 # Accept old syntax despite ".syntax unified"
 AFLAGS_NOWARN	:=$(call as-option,-Wa$(comma)-mno-warn-deprecated,-Wa$(comma)-W)
 
+ifeq ($(CONFIG_CC_IS_CLANG),y)
+CFLAGS_ABI	+= -meabi gnu
+endif
+
 ifeq ($(CONFIG_THUMB2_KERNEL),y)
 AFLAGS_AUTOIT	:=$(call as-option,-Wa$(comma)-mimplicit-it=always,-Wa$(comma)-mauto-it)
 CFLAGS_ISA	:=-mthumb $(AFLAGS_AUTOIT) $(AFLAGS_NOWARN)
@@ -225,6 +229,8 @@
 machine-$(CONFIG_ARCH_W90X900)		+= w90x900
 machine-$(CONFIG_ARCH_ZX)		+= zx
 machine-$(CONFIG_ARCH_ZYNQ)		+= zynq
+# XGIMI Play 6 (MStar/MediaTek DTV MT5889), as in the vendor tree
+machine-$(CONFIG_MSTAR_MT5889)		+= mt5889
 machine-$(CONFIG_PLAT_SPEAR)		+= spear
 
