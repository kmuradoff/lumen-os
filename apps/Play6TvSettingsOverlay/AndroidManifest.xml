<?xml version="1.0" encoding="utf-8"?>
<!-- Play 6, Lumen OS 1.0.6: static RRO for TvSettings (com.android.tv.settings) with only the Z9X switch fix
     (apps/Z9xTvSettingsHdrOverlay res/values/switch.xml and its layout, byte-identical, check_forks.py): the
     SwitchPreferenceCompat rows (Install unknown apps, accessibility services, a few developer options) said
     "Allowed" while their switch stayed off (owner 2026-10-24 on the Play 6). The Z9X HDR format list is not
     taken: it is Z9X-specific. Install: /system/product/overlay/Play6TvSettingsOverlay.apk (0644), priority 10,
     no code, no permissions. The stub/ is the link-time stub of TvSettings' ids, as the Z9X overlay's. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.z9x.overlay.tvsettings.play6"
    android:versionCode="106"
    android:versionName="1.0.6">
    <overlay android:targetPackage="com.android.tv.settings"
        android:isStatic="true"
        android:priority="10" />
    <application android:hasCode="false" />
</manifest>
