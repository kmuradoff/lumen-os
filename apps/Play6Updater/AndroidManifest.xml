<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0
  org.z9x.updater ("Lumen OS update") for Lumen OS on the XGIMI Play 6: fork of apps/Z9xUpdater
  (tools/play6/forks.tsv; the Z9X app and its pin stay as they are).
  Install: /system/app/Play6Updater/Play6Updater.apk, signed with the Play 6 platform key.
  Build: tools/play6/build_play6.sh (Play 6 platform key); the version is in this manifest.
  Differences: the package is a whole recovery OTA zip (tools/play6/ota/make_block_ota.py, signed with the
  Play 6 OTA key) downloaded to /cache/lumen_ota and installed by XGIMI's recovery, which trusts the Lumen
  certificate after the one-time step (tools/play6/recovery_trust.py): RecoverySystem.verifyPackage, then
  RecoverySystem.installPackage (BCB + restart). The system uid is needed for /cache and the BCB
  (android.permission.RECOVERY, as AOSP's own non-A/B updaters run). Manifest: the play6 channel
  (Ota.DEFAULT_MANIFEST_URL, tools/play6/ota/make_manifest_play6.py).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.z9x.updater"
    android:versionCode="600001"
    android:versionName="play6-1"
    android:sharedUserId="android.uid.system">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="34" />

    <!-- other apps of this image (Lumen Home badge, org.z9x.projector power policy) read the OTA
         state (provider call "state") and receive org.z9x.updater.action.OTA_STATE -->
    <permission
        android:name="org.z9x.updater.permission.OTA_STATE"
        android:protectionLevel="signature" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- W2: tell org.z9x.projector (power.OtaStateReceiver) "busy" so the SoC stays out of STR while
         update_engine writes (signature permission defined by org.z9x.projector) -->
    <uses-permission android:name="org.z9x.projector.permission.OTA_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- signature|privileged|...: the daily JobService may start the download service (FGS from
         the background) -->
    <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <!-- signature|privileged: PowerManager.reboot("z9x-ota") -->
    <uses-permission android:name="android.permission.REBOOT" />
    <!-- signature|privileged: RecoverySystem.installPackage writes the BCB through the recovery service -->
    <uses-permission android:name="android.permission.RECOVERY" />
    <!-- signature|appop|preinstalled: read update files from a USB stick (StorageVolume paths) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 1.0.1: About > Licences names Google's terms only where Google Play services are installed -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/brand_icon_updater"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Lumen.Updater">

        <activity
            android:name=".UpdaterActivity"
            android:label="@string/settings_title"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="locale|layoutDirection|keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter android:priority="10">
                <action android:name="android.settings.SYSTEM_UPDATE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".CheckJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".StateProvider"
            android:authorities="org.z9x.updater"
            android:exported="true"
            android:readPermission="org.z9x.updater.permission.OTA_STATE"
            android:writePermission="org.z9x.updater.permission.OTA_STATE" />
    </application>
</manifest>
