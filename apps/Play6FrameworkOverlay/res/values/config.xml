<?xml version="1.0" encoding="utf-8"?>
<!-- XGIMI Play 6 vendor apps hidden under Lumen OS (list from the owner's unit, v1.7.116:
     logs/play6_*/v1.7.116/packages.txt, every package installed from /vendor). See AndroidManifest.xml.
     Hardware protection (fan, LED, battery, motors, keystone servers) is done by native vendor services
     (gmpf_main, midaemon, serial_main, health HAL, ...), which keep running; none of these apps is needed
     to boot. Kept out on purpose: the factory test app, XGIMI's OTA updater (it must never try to install
     XGIMI firmware over Lumen) and the RGBD sensor firmware updater.
     t12 (docs/play6/SETTINGS_PLAN.md step 12): below the list, the framework values of Lumen OS. That part is
     a fork of apps/Z9xFrameworkKeysOverlay/res/values/config.xml (tools/play6/forks.tsv, check F:
     config_defaultAssistant, the eight config_cec* items and config_dreamsDefaultComponent must equal the
     Z9X values). Left out on purpose:
       - the KEYCODE_POWER items (config_shortPressOnPowerBehavior, config_longPressOnPowerBehavior,
         config_globalActionsList): base defaults until open question 12 (body key and IR power on the
         Play 6) is answered. The BT remote's power key is KEYCODE_STB_POWER and reaches
         org.z9x.projector's KeyReceiver through res/xml/global_keys.xml either way.
       - config_maxUiWidth: the Play 6 panel is 1080p, TvFrameworkOverlay's 1920 cap is right here. -->
<resources>
    <string-array name="config_disableApksUnlessMatchedSku_apk_list" translatable="false">
        <!-- launcher, setup, UI shell -->
        <item>com.xgimi.home</item>
        <item>com.xgimi.bootwizard</item>
        <item>com.xgimi.screensaver</item>
        <item>com.xgimi.skinmanager</item>
        <item>com.xgimi.xgimiframeworkui</item>
        <item>com.xgimiui.api</item>
        <item>com.xgimi.manager</item>
        <item>com.xgimi.config</item>
        <item>com.xgimi.persistentservice</item>
        <item>com.xgimi.msgcenter</item>
        <item>com.xgimi.instruction30</item>
        <item>com.xgimi.shutdown</item>
        <!-- updates, factory, diagnostics: must never run under Lumen -->
        <item>com.xgimi.upgrade</item>
        <item>com.xgimi.rgbdupgrade</item>
        <item>com.xgimi.minitvfactory</item>
        <item>com.xgimi.remote</item>
        <!-- ads, statistics, store, accounts, payments -->
        <item>com.xgimi.adservice</item>
        <item>com.xgimi.datareporter</item>
        <item>com.xgimi.appdb</item>
        <item>com.xgimi.newappmarket</item>
        <item>com.xgimi.payview</item>
        <item>com.xgimi.user</item>
        <item>com.xgimi.account</item>
        <item>com.xgimi.stream.video</item>
        <!-- media, casting, voice, IoT -->
        <item>com.xgimi.doubanfm</item>
        <item>com.xgimi.filemanager</item>
        <item>com.xgimi.gimiplayer</item>
        <item>com.xgimi.screenplayer</item>
        <item>com.xgimi.xhplayer</item>
        <item>com.xgimi.wirelessscreen</item>
        <item>com.xgimi.starmirror</item>
        <item>com.xgimi.smartconnect</item>
        <item>com.xgimi.duertts</item>
        <item>com.xgimi.vcontrol</item>
        <item>com.xgimi.iot</item>
        <item>com.xgimi.xgimiiotserver</item>
        <item>com.xgimi.xgimihilink</item>
        <item>com.xgimi.atmosphere</item>
        <item>com.xgimi.smartaccessories</item>
        <item>com.sohu.inputmethod.sogou.tv</item>
        <!-- projector functions: Lumen's projector app replaces them (Play 6 code table first) -->
        <item>com.xgimi.gmservice</item>
        <item>com.xgimi.autokst</item>
        <item>com.xgimi.tof</item>
    </string-array>

    <!-- ================= Lumen OS framework values (t12; fork of the Z9X file, see the header) ====

         Speed (docs/play6/inventory/D_play6_performance.md 6.3, plan section 4 item 4): 32 -> 8 cached
         processes (ActivityManagerConstants CUR_MAX_CACHED_PROCESSES; the empty-process limit becomes 4).
         t10 kept 24 cached processes 9 minutes after boot; on kernel 4.19 they cannot be frozen, so they
         also keep running code. No GMS on the Play 6, so no device_config value overrides this resource
         (the base SimpleDeviceConfig RRO sets no activity_manager key). The Z9X ships 10; never the Z9X's
         use_freezer DeviceConfig line here. -->
    <integer name="config_customizedMaxCachedProcesses">8</integer>

    <!-- As the Z9X: the Google Assistant (Katniss) is not on the image, so the ASSISTANT role (roles.xml:
         defaultHolders = config_defaultAssistant, fallBackToDefaultHolder = true) falls back to
         org.z9x.projector. Its RecentsActivity handles android.intent.action.ASSIST: a long press on HOME
         (Lineage action SEARCH, invocation_type 5) opens Recent apps; any other ASSIST opens Lumen Home
         search. VoiceInteractionManagerService then writes Settings.Secure.assistant to that activity. -->
    <string name="config_defaultAssistant" translatable="false">org.z9x.projector</string>

    <!-- HDMI-CEC defaults, the same values as the Z9X (read by HdmiCecConfig in system_server; a value
         stored earlier in /data wins). "TV wake on One Touch Play" = "Turn on with an HDMI device": OFF by
         default and user-configurable. Lumen's CEC wake policy and the vendor's CEC wake-up (IGmpf 645 /
         646) come to the Play 6 only in plan phase P2, after the sleep and wake test. -->
    <bool name="config_cecTvWakeOnOneTouchPlay_userConfigurable">true</bool>
    <bool name="config_cecTvWakeOnOneTouchPlayEnabled_default">false</bool>
    <bool name="config_cecTvWakeOnOneTouchPlayDisabled_default">true</bool>
    <!-- "Turn off devices with the projector" (tv_send_standby_on_sleep): ON, user-configurable. -->
    <bool name="config_cecTvSendStandbyOnSleep_userConfigurable">true</bool>
    <bool name="config_cecTvSendStandbyOnSleepEnabled_default">true</bool>
    <bool name="config_cecTvSendStandbyOnSleepDisabled_default">false</bool>
    <!-- <Set Menu Language> broadcast OFF by default (a console would follow the projector's UI
         language every time CEC starts). -->
    <bool name="config_cecSetMenuLanguageEnabled_default">false</bool>
    <bool name="config_cecSetMenuLanguageDisabled_default">true</bool>

    <!-- Default screensaver, as the Z9X: the living sky of Lumen Home (org.z9x.home.sky.SkyDreamService).
         TvFrameworkOverlay sets com.android.dreams.basic Colors, and BasicDreams leaves the Play 6 image
         (tools/play6/compose.sh step 0b, D 6.5), so the old default would point at a missing package.
         SettingsProvider copies this value into Settings.Secure screensaver_default_component on a fresh
         userdata only; DreamManagerService falls back to it when screensaver_components is empty or names
         a missing dream. -->
    <string name="config_dreamsDefaultComponent" translatable="false">org.z9x.home/org.z9x.home.sky.SkyDreamService</string>

    <!-- Play 6 only (docs/play6/inventory/C_play6_hal_capability.md 5.1, plan 1.6): the model has no 3.5 mm
         jack (G0058 feature file: support_wired_headphone false), but the kernel's h2w switch reports a
         plugged headphone at boot, so on t10 AudioService routed every stream to headphone(8). With true,
         WiredAccessoryManager ignores the h2w switch and listens for input switch events
         (SW_HEADPHONE_INSERT), which this device does not have: no wired headset, music on the speaker.
         t10 left the speaker's music index at 0; org.z9x.projector (Play6App) sets it to 8 once (test A3). -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>
</resources>
