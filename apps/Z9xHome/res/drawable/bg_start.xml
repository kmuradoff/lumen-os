<?xml version="1.0" encoding="utf-8"?>
<!-- Starting window (SPEC 10.1): the Lumen ground with a low warm horizon and a cool dusk top, so the
     first frame of the living sky does not flash against it (direction D palette). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="@color/lumen_ground" /></item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.72" android:centerY="0.66"
                android:gradientRadius="70%p" android:startColor="@color/lumen_glow_a" android:endColor="#00B8743A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0"
                android:gradientRadius="90%p" android:startColor="@color/lumen_glow_b" android:endColor="#00384A5E" />
        </shape>
    </item>
</layer-list>
