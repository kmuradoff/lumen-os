<?xml version="1.0" encoding="utf-8"?>
<!-- Play 6-only texts of org.z9x.projector (docs/play6/SETTINGS_PLAN.md 2.4, section 5 steps 16, 17; t13:
     docs/play6/research/battery_sound_features.md section 6).
     English base; translations: apps/Play6Projector/i18n/langs/<locale>.txt @play6/strings_p6.xml, generated by
     tools/play6/gen_play6_i18n.py into values-<locale>/strings_p6.xml. Shared texts stay in the shared strings
     files (apps/common/projector); strings_kst.xml of the Z9X app is not shared, so the manual keystone texts
     the Play 6 card uses are copied here with the same names and wording (kst_*). -->
<resources>
    <!-- low-battery cards and notices (plan 3.3, battery/BatteryNotices); %1$d = the battery level. The Battery
         tile and page are gone since t13 (research 6.1 B8: Lumen Home shows the battery) -->
    <string name="p6_batt_low">Battery low: %1$d %% left</string>
    <string name="p6_batt_very_low">Battery very low: %1$d %% left</string>
    <string name="p6_batt_connect">Connect the power adapter.</string>
    <string name="p6_batt_empty_title">Battery almost empty</string>
    <string name="p6_batt_empty_msg">Connect the power adapter, or turn the projector off.</string>
    <string name="p6_batt_turn_off">Turn off</string>
    <string name="p6_batt_keep_watching">Keep watching</string>
    <!-- countdown band after the vendor's "battery empty" event; %1$d = seconds left (10..1) -->
    <string name="p6_batt_countdown_title">Battery empty</string>
    <string name="p6_batt_countdown_msg">The projector turns off in %1$d s. Connect the power adapter to keep watching.</string>
    <!-- power source cards after a vendor power event (stock SystemUI BatteryHelper, research 1.4 and 6.1 B5):
         the title, then the power saving line when it applies -->
    <string name="p6_card_internal">Powered by the internal battery</string>
    <string name="p6_card_adapter">Power adapter connected</string>
    <string name="p6_card_low_power">Power bank or third-party adapter connected</string>
    <string name="p6_card_stand">Battery stand connected</string>
    <string name="p6_card_eco_on">Power saving is on</string>
    <string name="p6_card_eco_off">Power saving is off</string>
    <!-- quick panel: picture modes of the Play 6 (plan 1.4) -->
    <string name="p6_pm_movie">Movie</string>
    <string name="p6_pm_tv">TV</string>
    <string name="p6_pm_custom">Custom</string>
    <string name="p6_pm_game">Game</string>
    <string name="p6_pic_game_hint">Game mode sets the picture. Turn game mode off to choose another picture mode.</string>
    <!-- notices of game mode Auto on HDMI (t18, game/GameMode): Auto turned game mode on by itself for a console
         (the console's CEC name below it when known, wording as the Z9X game_cue_title), and off again once the
         console has gone -->
    <string name="p6_game_on">Game mode on</string>
    <string name="p6_game_off">Game mode off</string>
    <!-- quick panel: focus -->
    <string name="p6_smart_af_desc">The picture is focused again after the projector is moved.</string>
    <!-- quick panel: Brightness page, the vendor's power saving and its switch (stock eco_mode_switch, IGmpf
         327 / 328, research 1.4 and 6.1 B6); the two confirmations come the first time each way -->
    <string name="p6_lamp_hint">On battery the projector turns on power saving and lowers the brightness. Raising the brightness turns power saving off.</string>
    <string name="p6_eco">Power saving</string>
    <string name="p6_eco_on_title">Turn power saving on?</string>
    <string name="p6_eco_on_msg">Power saving lowers brightness and sound so the battery lasts longer. Recommended on the XGIMI battery stand or a power bank.</string>
    <string name="p6_eco_off_title">Turn power saving off?</string>
    <string name="p6_eco_off_msg">On the XGIMI battery stand or a power bank, turning power saving off can increase consumption or make the projector turn off.</string>
    <string name="p6_eco_turn_on">Turn on</string>
    <string name="p6_eco_turn_off">Turn off</string>
    <!-- manual keystone card: second hint line (no reset on the Play 6) -->
    <string name="p6_kst_hint_back">Back: save and exit</string>
