<?xml version="1.0" encoding="utf-8"?>
<!--
  org.lumen.info ("Signal Info" / "Сигнал") for Lumen OS: what the projector receives, plays and outputs (video, HDR,
  audio, HDMI inputs with their built-in EDID, system), as a TV screen and as an always-on-top overlay. README.md.

  android:sharedUserId="android.uid.system": the vendor policy of the Z9X HB lets only system_app reach the
  xgimi.hardware.gmpf services, read /vendor/tvconfig/bsp/common/EDID_BIN and /mnt/vendor/xgimiconfig, and the
  system uid holds DUMP (service dumps), REAL_GET_TASKS (app on screen), SYSTEM_ALERT_WINDOW and
  INTERNAL_SYSTEM_WINDOW (trusted overlay). So the working build is signed with the device's platform key
  (build_hb.sh). From HB image t11 it is a priv-app of the image (/system/priv-app/LumenInfo, not persistent,
  privapp-permissions-lumeninfo.xml); before that it was a plain `adb install -r`. The test-key build
  (build.sh) is only a compile check: Android refuses it because the shared user's certificate differs.
  Version 0.2 (versionCode 2): the same code as 0.1; the higher code makes the image copy replace a 0.1 left in
  /data/app by an earlier adb install (PackageManager drops a data copy older than the system one).
  Version 0.3 (versionCode 3, 2026-11-01): the extra read-only vendor getters allowed
  (devices/goat_elegant/research/allowed_lumeninfo.tsv); an adb install -r replaces the 0.2 of the image.
  Version 0.4 (versionCode 4, 2026-11-03): the device on the ARC / eARC port, both directions (Audio page): its
  CEC name and addresses, the Short Audio Descriptors it reported, the encodings Android may send it, and the
  audio block of our own EDID on that port.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lumen.info"
    android:sharedUserId="android.uid.system"
    android:versionCode="4"
    android:versionName="0.4">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="34" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon_info"
        android:banner="@drawable/banner_info"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumen.Info">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ToggleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.lumen.info.action.TOGGLE_OVERLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-screen signal information overlay, while the user has it switched on" />
        </service>

        <!-- adb check without the screen (LogReceiver); only holders of DUMP may send it -->
        <receiver
            android:name=".LogReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.lumen.info.action.LOG" />
            </intent-filter>
        </receiver>

        <service
            android:name=".OverlayTile"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_stat_info"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
