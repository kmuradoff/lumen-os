+/* z9x: RTP timestamp of the missing first_seqnum, interpolated between the last packet
+   dequeued and the first one received after the gap (that one's own if there is none) */
+static uint32_t
+raop_buffer_missing_rtp(raop_buffer_t *raop_buffer, unsigned short next_seqnum, uint32_t next_rtp) {
+    if (!raop_buffer->last_out_valid) {
+        return next_rtp;
+    }
+    short span = seqnum_cmp(next_seqnum, raop_buffer->last_out_seqnum);
+    short pos = seqnum_cmp(raop_buffer->first_seqnum, raop_buffer->last_out_seqnum);
+    int32_t diff = (int32_t) (next_rtp - raop_buffer->last_out_rtp);
+    if (span <= 0 || pos <= 0 || pos >= span || diff <= 0) {
+        return next_rtp;
+    }
+    return raop_buffer->last_out_rtp + (uint32_t) ((int64_t) diff * pos / span);
+}
