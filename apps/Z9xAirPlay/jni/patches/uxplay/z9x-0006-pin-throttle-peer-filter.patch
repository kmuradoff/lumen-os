+/* z9x: PIN brute-force throttle. Every wrong code counts (any connection, any sender);
+   Z9X_PIN_MAX_FAILURES wrong codes lock PIN pairing for 30 s, doubling per lockout up to
+   15 min; a successful pairing resets everything. In random mode (pin < 10000) a code is
+   used for at most one wrong guess: the next pair-pin-start shows a new one. */
+#define Z9X_PIN_MAX_FAILURES 3
+#define Z9X_PIN_LOCK_BASE_SECS 30u
+#define Z9X_PIN_LOCK_MAX_SECS 900u
+#define Z9X_PIN_VALID_NS (300ull * 1000000000ull)
+
+static uint64_t
+z9x_pin_now_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec * 1000000000ull + (uint64_t) ts.tv_nsec;
+}
+
+/* seconds left of a lockout (0 = not locked) */
+static int
+z9x_pin_locked_secs(raop_t *raop) {
+    uint64_t now = z9x_pin_now_ns();
+    if (raop->pin_locked_until_ns <= now) {
+        return 0;
+    }
+    return (int) ((raop->pin_locked_until_ns - now + 999999999ull) / 1000000000ull);
+}
+
 static void
+z9x_pin_failed(raop_t *raop) {
+    raop->pin_pending = false;
+    if (++raop->pin_failures < Z9X_PIN_MAX_FAILURES) {
+        return;
+    }
+    unsigned int secs = Z9X_PIN_LOCK_BASE_SECS;
+    for (unsigned int i = 0; i < raop->pin_lockouts && secs < Z9X_PIN_LOCK_MAX_SECS; i++) {
+        secs *= 2;
+    }
+    if (secs > Z9X_PIN_LOCK_MAX_SECS) {
+        secs = Z9X_PIN_LOCK_MAX_SECS;
+    }
+    raop->pin_failures = 0;
+    raop->pin_lockouts++;
+    raop->pin_locked_until_ns = z9x_pin_now_ns() + (uint64_t) secs * 1000000000ull;
+    logger_log(raop->logger, LOGGER_WARNING, "PIN pairing locked for %u s after %d wrong codes",
+               secs, Z9X_PIN_MAX_FAILURES);
+    if (raop->callbacks.pin_lockout) {
+        raop->callbacks.pin_lockout(raop->callbacks.cls, (int) secs);
+    }
+}
+
+static void
+z9x_pin_succeeded(raop_t *raop) {
+    raop->pin_pending = false;
+    raop->pin_failures = 0;
+    raop->pin_lockouts = 0;
+}
