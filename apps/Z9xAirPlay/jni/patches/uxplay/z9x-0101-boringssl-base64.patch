z9x-0101: pk_to_base64 with EVP_EncodeBlock (BoringSSL has no BIO_f_base64 in libcrypto)

Our own patch against FDH2/UxPlay master 3dbf7ce (paths relative to UxPlay/lib).
Applied by jni/build_native.sh inside a copy of UxPlay/lib with patch -p1 --fuzz=0.
SPDX-License-Identifier: GPL-3.0-or-later

diff --git a/crypto.c b/crypto.c
index 762c648..ab1f2ac 100644
--- a/crypto.c
+++ b/crypto.c
@@ -606,21 +606,10 @@ void pk_to_base64(const unsigned char *pk, int pk_len, char *pk_base64, int len)
     int len64 = (4 * (pk_len /3)) + (pk_len % 3 ? 4 : 0);
     
     assert (len > len64);
-    
-    BIO *b64 = BIO_new(BIO_f_base64());
-    BIO *bio = BIO_new(BIO_s_mem());
-    BUF_MEM *bufferPtr = NULL;
-
 
-    bio = BIO_push(b64, bio);
-  
-    BIO_set_flags(bio, BIO_FLAGS_BASE64_NO_NL);
-    BIO_write(bio, pk, pk_len);
-    BIO_flush(bio);
-
-    BIO_get_mem_ptr(bio, &bufferPtr);
-    BIO_set_close(bio, BIO_NOCLOSE);
-    BIO_free_all(bio);
-    memcpy(pk_base64,(*bufferPtr).data, len64);
+    /* z9x: EVP_EncodeBlock (OpenSSL and BoringSSL) instead of a base64 BIO chain:
+       BoringSSL keeps BIO_f_base64 only in its "decrepit" library, and the BIO version
+       leaked the BUF_MEM. Same output: padded base64, no newline, NUL-terminated. */
+    EVP_EncodeBlock((unsigned char *) pk_base64, pk, pk_len);
 }
   
