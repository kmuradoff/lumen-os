+/* z9x (from jqssun 0004): copy a plist string so that every path frees with free() */
+static char *_plist_dup_string(plist_t dict, const char *key) {
+    plist_t node = dict ? plist_dict_get_item(dict, key) : NULL;
+    char *val = NULL;
+    if (node) {
+        plist_get_string_val(node, &val);
+    }
+    if (!val) {
+        return NULL;
+    }
+    char *copy = strdup(val);
+    plist_mem_free(val);
+    return copy;
