+/* z9x: playlists handed out by the getters are copies (caller frees), so a refresh or
+   teardown on another thread can never free a buffer that is still being served */
+static char *_raw_copy_playlist(const char *s) {
+    size_t len = strlen(s);
+    char *copy = (char *) malloc(len + 1);
+    if (!copy) {
+        printf("Memory allocation failure (playlist_copy)\n");
+        exit(1);
+    }
+    memcpy(copy, s, len);
+    copy[len] = '\0';
+    return copy;
+}
