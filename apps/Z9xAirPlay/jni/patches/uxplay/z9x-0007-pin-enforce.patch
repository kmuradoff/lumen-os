+
+/* z9x: same peer address (ports ignored) */
+static bool
+z9x_same_peer(const raop_conn_t *a, const raop_conn_t *b) {
+    return a->remotelen == b->remotelen && !memcmp(a->remote, b->remote, (size_t) a->remotelen);
+}
+
+/* z9x: requests a sender may make before pair-verify in PIN mode (discovery and pairing) */
+static bool
+z9x_public_handler(raop_handler_t handler) {
+    return handler == &raop_handler_info || handler == &raop_handler_options ||
+           handler == &raop_handler_pairpinstart || handler == &raop_handler_pairsetup_pin ||
+           handler == &raop_handler_pairsetup || handler == &raop_handler_pairverify ||
+           handler == &http_handler_server_info || handler == &http_handler_hls;
+}
+
+/* z9x: in PIN mode (use_pin) fp-setup, SETUP, RECORD, SET_PARAMETER, /feedback, ... are
+   handled only on a connection that completed pair-verify as a trusted or PIN-paired client.
+   An AirPlay (HTTP: /reverse, /play, /scrub, /rate, ...) connection is admitted when a
+   verified RAOP connection from the same address exists; it then stays admitted. */
+static bool
+z9x_request_admitted(raop_t *raop, raop_conn_t *conn, raop_handler_t handler) {
+    if (!raop->use_pin || conn->z9x_verified || z9x_public_handler(handler)) {
+        return true;
+    }
+    if (conn->connection_type == CONNECTION_TYPE_AIRPLAY || conn->connection_type == CONNECTION_TYPE_PTTH) {
+        for (int i = 1; ; i++) {
+            raop_conn_t *raop_conn = (raop_conn_t *) httpd_get_connection_by_type(raop->httpd, CONNECTION_TYPE_RAOP, i);
+            if (!raop_conn) {
+                break;
+            }
+            if (raop_conn->z9x_verified && z9x_same_peer(raop_conn, conn)) {
+                conn->z9x_verified = true;
+                return true;
+            }
+        }
+    }
+    return false;
+}
 
