<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen OS on the XGIMI Play 6, Google test edition only (tools/play6/build_test.sh with its gms option): image path
     /system/etc/sysconfig/lumen-gapps.xml. The no-Google Play 6 image never carries it. Fork of
     tools/ota/image/z9x-gapps-sysconfig.xml (tools/play6/forks.tsv); sign_play6.py gms checks that its
     elements stay exactly the Z9X layer's. Later the lumen_gapps add-on shows the same lines through its
     sysconfig overlay (docs/play6/OTA_GMS_PLAN.md section 3).
     - initial-package-state: LineageOS 21 starts a first-seen system package with a LAUNCHER activity in the
       "stopped" state (config_stopSystemPackagesByDefault); the Android TV Remote Service starts only from
       BOOT_COMPLETED, Play's boot and auto-update work, GMS / GSF (precaution);
     - SetupWraith stays installed for Google sign-in (its AddAccount activities) but its own wizard (a HOME
       activity) and its boot receiver never run: Lumen Home stays HOME;
     - GMS's Pano system update screen is off: Lumen OS updates never come from Google. -->
<config>
    <initial-package-state package="com.google.android.tv.remote.service" stopped="false" />
    <initial-package-state package="com.android.vending" stopped="false" />
    <initial-package-state package="com.google.android.gms" stopped="false" />
    <initial-package-state package="com.google.android.gsf" stopped="false" />

    <component-override package="com.google.android.tungsten.setupwraith">
        <component class="com.google.android.tungsten.setupwraith.MainActivity" enabled="false" />
        <component class="com.google.android.tvsetup.app.BootCompletedReceiver" enabled="false" />
    </component-override>

    <component-override package="com.google.android.gms">
        <component class="com.google.android.gms.update.SystemUpdatePanoActivity" enabled="false" />
    </component-override>
</config>
